                                <Polygon
                                    Canvas.Left="720"
                                    Canvas.Top="583"
                                    Fill="White"
                                    Points="0,0 60,0 140,80 140,200 60,280 0,280 0,0"
                                    Tag="{x:Static local:TouchValue.C1}" />
                                <Polygon
                                    Canvas.Left="579"
                                    Canvas.Top="583"
                                    Fill="White"
                                    Points="141,280 81,280 0,199 1,81 81,0 141,0 141,280"
                                    Tag="{x:Static local:TouchValue.C2}" />


                            </Canvas>
                            <!--  HwndHost input surface will be added programmatically as an overlay here  -->

                        </Grid>
                    </Border>
                </Viewbox>
            </DockPanel>

            <!-- Overlay popup to ensure grip renders above HwndHost (airspace fix) -->
            <Popup
                x:Name="ResizeGripPopup"
                AllowsTransparency="True"
                PlacementTarget="{Binding ElementName=touchPanelBorder}"
                Placement="Relative"
                StaysOpen="True"
                IsOpen="True">
                <Border
                    x:Name="ResizeGrip"
                    Width="150"
                    Height="90"
                    MouseDown="ResizeGrip_MouseDown"
                    Style="{StaticResource ResizeGripStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="Resize"
                        FontSize="50"
                        Text="{Binding LbTouchPanelResize}" />
                </Border>
            </Popup>

        </Grid>

    </Border>

</Window>
