<Window
    x:Class="WpfMaiTouchEmulator.TouchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMaiTouchEmulator.Managers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TouchPanel"
    Width="720"
    Height="1280"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="DraggableHandleStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFEEEEEE" />
                        <GradientStop Offset="1" Color="#FFCCCCCC" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="5"
                        ShadowDepth="2"
                        Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeGripStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFCCCCCC" />
                        <GradientStop Offset="1" Color="#FFAAAAAA" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="5"
                        ShadowDepth="2"
                        Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#01000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="DragWindowHandle"
                Width="100"
                Height="50"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                Style="{StaticResource DraggableHandleStyle}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="Drag"
                    FontSize="24"
                    Text="{Binding LbTouchPanelDrag}" />
            </Border>
            <DockPanel VerticalAlignment="Bottom">
                <Viewbox Opacity="1" Stretch="Uniform">
                    <Border
